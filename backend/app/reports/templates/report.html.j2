{% from "macros.html.j2" import disclaimer %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ data.region_name }} 청약 분석 보고서 — {{ data.asof_date }}</title>
<style>
{{ css }}
</style>
</head>
<body>
{% include "cover.html.j2" %}
<nav id="toc">
  <strong>목차</strong> <span class="small">— 본문 §1~§9{% if data.extra %}·§12{% endif %}, 부록 A~D(판정기 기록·참고자료·용어 풀이·전체 표)</span>
  <ol>
  {% for t in SECTION_TITLES %}<li><a href="#s{{ loop.index }}">{{ t }}</a></li>{% endfor %}
  {% if data.extra %}<li><a href="#s12">{{ EXTRA_TITLE }}</a></li>{% endif %}
  <li><a href="#appx-c">{{ APPENDIX_C_TITLE }}</a></li>
  <li><a href="#appx-d">{{ APPENDIX_D_TITLE }}</a></li>
  </ol>
</nav>
<main>
{% include "s01.html.j2" %}
{% include "s02.html.j2" %}
{% include "s03.html.j2" %}
{% include "s04.html.j2" %}
{% include "s05.html.j2" %}
{% include "s06.html.j2" %}
{% include "s07.html.j2" %}
{% include "s08.html.j2" %}
{% include "s09.html.j2" %}
{% include "s10.html.j2" %}
{% include "s11.html.j2" %}
{% if data.extra %}{% include "s12.html.j2" %}{% endif %}
{% include "appx_c.html.j2" %}
{% include "appx_d.html.j2" %}
</main>
<footer>
  {{ disclaimer() }}
  <p class="small">이 문서는 공개 분양 정보와 판정기 기록으로 만든 상대 비교다. 수익 보장 아님. 생성: subscription-analyzer 보고서 내보내기(스냅샷 #{{ data.snapshot_id }}).</p>
</footer>
{% if has_echarts %}<script>{{ echarts_js }}</script>{% endif %}
<script>{{ init_js }}</script>
</body>
</html>

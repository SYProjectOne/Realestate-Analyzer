{% from "macros.html.j2" import fact, sec_head, chart %}
<section id="s5">
  {{ sec_head(5) }}
  <p class="lead">생활권별 벤치마크 {{ data.benchmarks | length }}건, 호재 {{ data.catalysts | length }}건(미해결 {{ data.catalysts | selectattr("unresolved") | list | length }}), 출처 충돌 {{ data.conflicts | length }}건, 입주 물량 {{ data.supply | length }}행, 미분양 {{ data.unsold | length }}행.</p>
  <h3>5-1. 벤치마크 — 분양가 → 최근 실거래(전용 84㎡)</h3>
  {% for la, rows in data.benchmarks | groupby("living_area_name") %}
  <h4>{{ la }} — 최근 3년 분양분 사례: {{ "있음" if data.recent_sale_cases.get(la) else "없음(저가 분양기 사례만 — 해석 주의)" }}</h4>
  <table>
    <thead><tr><th>단지</th><th>준공</th><th>분양 연도</th><th>분양가</th><th>실거래 중앙값</th><th>변동률</th><th>비고</th></tr></thead>
    <tbody>
    {% for b in rows %}
      <tr><td>{{ b.name }}</td><td>{{ fact(b.completed_year) }}</td><td>{{ fact(b.sale_year) }}</td><td>{{ fact(b.sale_price) }}</td><td>{{ fact(b.trade_median) }}</td><td>{{ fact(b.change_pct) }}</td><td>{{ "분양권(벤치마크 점수 제외)" if b.is_presale else "" }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>벤치마크 없음 — 확인 불가(수집 전)</p>
  {% endfor %}
  <h3>5-2. 호재 단계(판정기 classify)</h3>
  <table>
    <thead><tr>{% for s in data.stage_counts %}<th>{{ s.stage }}</th>{% endfor %}</tr></thead>
    <tbody><tr>{% for s in data.stage_counts %}<td class="num">{{ s.n }}건</td>{% endfor %}</tr></tbody>
  </table>
  <table>
    <thead><tr><th>호재</th><th>종류</th><th>단계</th><th>확률</th><th>판정</th><th>비고</th></tr></thead>
    <tbody>
    {% for c in data.catalysts %}
      <tr><td>{{ c.name }}</td><td>{{ c.kind }}</td><td>{{ c.stage }}</td><td>{{ fact(c.prob) }}</td><td>{{ c.decision or "—" }}</td>
        <td>{% if c.unresolved %}<span class="badge warn">미해결 — 상승 근거로 쓰지 않음</span>{% endif %} {{ c.note or "" }}</td></tr>
    {% else %}
      <tr><td colspan="6">호재 없음</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <h3>5-3. 출처 충돌(같은 사실, 다른 값)</h3>
  <table>
    <thead><tr><th>단지</th><th>항목</th><th>채택 값</th><th>나머지(보관)</th><th>판정기 compare</th></tr></thead>
    <tbody>
    {% for c in data.conflicts %}
      <tr><td>{{ c.complex_name }}</td><td>{{ c.group }}</td><td>{{ c.chosen_text }} <span class="lb" data-label="{{ c.chosen_label }}">{{ c.chosen_label }}</span></td>
        <td>{{ c.others | join(" / ") if c.others else "—" }}</td>
        <td>{% if c.compare_seq %}#{{ c.compare_seq }} {{ c.compare_status or "" }}{% else %}미호출(우선순위로 채택){% endif %}</td></tr>
    {% else %}
      <tr><td colspan="5">출처 충돌 없음</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <h3>5-4. 입주 물량</h3>
  {{ chart(charts.get("c04"), has_echarts) }}
  <h3>5-5. 미분양(월말 기준)</h3>
  <table>
    <thead><tr><th>범위</th><th>연월</th><th>합계</th><th>준공 후</th></tr></thead>
    <tbody>
    {% for u in data.unsold %}
      <tr><td>{{ u.scope }}</td><td>{{ u.ym }}</td><td>{{ fact(u.total) }}</td><td>{{ fact(u.post_completion) }}</td></tr>
    {% else %}
      <tr><td colspan="4">미분양 자료 없음</td></tr>
    {% endfor %}
    </tbody>
  </table>
</section>

{% from "macros.html.j2" import fact, sec_head, intake, chart, disclaimer %}
{% macro pre(p) -%}
{% if p %}{{ p.status }}<br><span class="small">{{ p.evidence }}</span>{% else %}—{% endif %}
{%- endmacro %}
<section id="s8">
  {{ sec_head(8) }}
  {% set base = data.scenarios | selectattr("code", "equalto", data.scenario_code) | first | default(none) %}
  {% set picked = base.decisions | selectattr("chosen") | map(attribute="option") | list if base else [] %}
  <p class="lead">{{ data.scenario_name }} 기준 판정기 선택은 {{ picked | join(" · ") if picked else "없음(미판정)" }}{% if base and base.tie %} — 동률(confidence &lt; 0.6, 1순위를 하나로 말하지 않음){% endif %}. 상황별 결과와 요건 매트릭스를 아래에 둔다.</p>
  <p class="small">이 장은 판정기 결과와 점수를 모아 정리한 것이다 — 새 판단이나 권유를 더하지 않는다. {{ term("scenario") }}마다 가중치와 판정기 선택이 다르다.</p>
  <h3>8-1. TOP 5 종합 비교표</h3>
  <table>
    <thead><tr><th>순위</th><th>단지</th><th>종합</th><th>+10% 확률(입주 후 1년)</th><th>가격 갭 점수</th><th>현재 구매가</th><th>계약금</th><th>전매제한</th><th>접수</th></tr></thead>
    <tbody>
    {% for s in data.top5 %}
      {% set c = data.complex_by_id.get(s.complex_id) %}
      {% set lad = data.ladders | selectattr("complex_id", "equalto", s.complex_id) | first | default(none) %}
      <tr><td>{{ s.rank }}위</td><td>{{ s.name }}{% if c and c.rejudge_needed %} <span class="badge warn rejudge" title="{{ c.rejudge_text }}">재판정 필요</span>{% endif %}</td><td>{{ fact(s.total) }}</td>
        <td>{% if c and c.judge_scope != "판정 대상" %}{{ c.scope_note }}{% elif lad %}{{ fact(lad.p10) }}{% else %}확인 불가(사다리 없음){% endif %}</td>
        <td>{% if "gap" in s.components %}{{ fact(s.components.gap.score) }}{% else %}—{% endif %}</td>
        <td>{% if c %}{{ fact(c.price_low) }} ~ {{ fact(c.price_high) }}{% endif %}</td>
        <td>{% if c and c.current_payment %}{{ fact(c.current_payment.down_payment_pct) }}{% else %}—{% endif %}</td>
        <td>{% if c %}{{ fact(c.facts.resale_months) }}{% endif %}</td>
        <td>{% if c %}{{ intake(c.intake_shown) }}{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <h3>8-2. 상황별 판정기 선택(decide) — 요건 3개(접근 가능성 / 규제 제약 / 자금)</h3>
  <table class="scenario-summary">
    <thead><tr><th>상황</th><th>판정기 선택</th><th>확률</th><th>confidence</th><th>차순위</th><th>decide</th></tr></thead>
    <tbody>
    {% for b in data.scenarios %}
      {% set chosen = b.decisions | selectattr("chosen") | list %}
      <tr><td>{{ b.code }} — {{ b.name }}</td>
        <td>{% for d in chosen %}{{ d.option }}{% if d.virtual %} <span class="badge">가상 후보</span>{% endif %}{% if not loop.last %} · {% endif %}{% else %}없음(미판정){% endfor %}{% if b.tie %} <span class="badge warn">동률</span>{% endif %}</td>
        <td>{% for d in chosen %}{{ fact(d.prob) }}{% if not loop.last %} · {% endif %}{% else %}—{% endfor %}</td>
        <td>{% if b.decisions %}{{ fact(b.confidence) }}{% else %}—{% endif %}</td>
        <td>{% for d in b.runner_up %}{{ d.option }}{% if d.virtual %}(가상 후보){% endif %} {{ fact(d.prob) }}{% if not loop.last %} · {% endif %}{% else %}—{% endfor %}</td>
        <td>{% if b.judgment_seq %}#{{ b.judgment_seq }} {{ b.status or "" }}{% else %}기록 없음{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="small">'모집공고 대기'는 가상 후보다(계약 2026-10-09.5) — 12개월 안 공고 예정 단지를 기다리는 선택지로, 시나리오 정책(include_wait_new)이 켠 상황에서만 decide 후보에 들어간다. 단지가 아니므로 점수·사다리가 없고 요건은 판정기 판정만 있다(사전 계산 없음).</p>
  {{ chart(charts.get("c07"), has_echarts) }}
  {% for b in data.scenarios %}
  <h4>상황 {{ b.code }} — {{ b.name }} · 가중치 {% for k, w in b.weights.items() %}{{ COMPONENT_LABELS.get(k, k) }} {{ "%.2f" | format(w) }}{% if not loop.last %} · {% endif %}{% endfor %}</h4>
  <table>
    <thead><tr><th>순위</th><th>단지</th><th>종합</th></tr></thead>
    <tbody>
    {% for s in b.top %}<tr><td>{{ s.rank }}위</td><td>{{ s.name }}</td><td>{{ fact(s.total) }}</td></tr>
    {% else %}<tr><td colspan="3">점수 없음</td></tr>{% endfor %}
    </tbody>
  </table>
  {% if b.code != data.scenario_code %}{{ chart(charts.get("c07_" ~ b.code), has_echarts) }}{% endif %}
  {% if b.decisions %}
  <p class="small">decide #{{ b.judgment_seq }} · 상태 {{ b.status or "—" }} · confidence {{ fact(b.confidence) }}{% if b.tie %} · <span class="badge warn">동률</span>{% endif %}</p>
  <table>
    <thead><tr><th>선택지</th><th>확률</th><th>선택</th><th>접근 가능성(사전 계산 / 판정기)</th><th>규제 제약</th><th>자금</th><th>배지</th></tr></thead>
    <tbody>
    {% for d in b.decisions %}
      <tr class="{{ 'chosen' if d.chosen else '' }}"><td>{{ d.option }}</td><td>{{ fact(d.prob) }}</td><td>{{ "선택" if d.chosen else "" }}</td>
        {% for req in ("access", "regulation", "funds") %}<td>{{ pre(d.pre[req]) }}<br>판정기: {{ d.judge[req] or "—" }}</td>{% endfor %}
        <td>{% if d.virtual %}<span class="badge">가상 후보</span>{% endif %}{% if d.tie %}<span class="badge warn">동률</span>{% endif %}{% if d.mismatch %}<span class="badge warn">증거와 상이</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% if b.has_wait_new %}
  <div class="wait-new-evidence">
    <p class="small"><span class="badge">가상 후보</span> 모집공고 대기 근거(decide #{{ b.judgment_seq }} 입력의 [wait_new] 블록):</p>
    {% if b.wait_new_evidence %}<pre class="small">{{ b.wait_new_evidence }}</pre>{% else %}<p class="small">근거 블록 기록 없음 — 이 decide 입력(녹화)에 공고 예정 목록 요약이 없다. 요건 판정은 판정기 값만(사전 계산 없음).</p>{% endif %}
  </div>
  {% endif %}
  {% for w in b.warnings %}<p class="note">판정기 경고: {{ w }}</p>{% endfor %}
  {% else %}
  <p class="small">이 상황의 decide 기록 없음 — 미판정.</p>
  {% endif %}
  {% endfor %}
  <h3>8-3. 청약·계약 전 체크리스트</h3>
  <table>
    <thead><tr><th>구분</th><th>항목</th><th>단지</th><th>기한</th><th>상태</th></tr></thead>
    <tbody>
    {% for i in data.checklist %}<tr><td>{{ i.kind }}</td><td>{{ i.title }}</td><td>{{ i.complex_name }}</td><td>{{ i.due or "—" }}</td><td>{{ i.status }}</td></tr>
    {% else %}<tr><td colspan="5">체크리스트 항목 없음(G7에서 추가)</td></tr>{% endfor %}
    {% for s in data.top5 %}{% set c = data.complex_by_id.get(s.complex_id) %}
      {% if c and (c.intake_shown is none or c.intake_shown.status != "가능") %}<tr><td>접수 확인</td><td>접수 가능 여부 사람 확인(전화·방문)</td><td>{{ c.name }}</td><td>—</td><td>open</td></tr>{% endif %}
    {% endfor %}
    </tbody>
  </table>
  <h3>8-4. 향후 3개월 캘린더({{ data.asof_date }} ~)</h3>
  <table>
    <thead><tr><th>날짜</th><th>일정</th><th>단지</th><th>값</th></tr></thead>
    <tbody>
    {% for r in data.calendar %}<tr><td>{{ r.day }}</td><td>{{ r.what }}</td><td>{{ r.complex_name }}</td><td>{% if r.fact %}{{ fact(r.fact) }}{% else %}체크리스트{% endif %}</td></tr>
    {% else %}<tr><td colspan="4">3개월 안 일정 없음(공고 예상은 확인 불가)</td></tr>{% endfor %}
    </tbody>
  </table>
  <h3>8-5. 최종 검증(판정기 verify)</h3>
  <table>
    <thead><tr><th>섹션</th><th>결과</th><th>호출</th></tr></thead>
    <tbody>
    {% for v in data.verify if not v.section.startswith("7") %}
      <tr><td>{{ v.section }}</td><td>{% for k, n in v.counts | dictsort %}{{ k }} {{ n }}건{% if not loop.last %} · {% endif %}{% endfor %}</td><td>{% for q in v.judgment_seqs %}#{{ q }} {% endfor %}</td></tr>
    {% else %}
      <tr><td colspan="3">최종 검증 기록 없음</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="note">남은 contradicted 주장 0건(있으면 보고서를 만들지 않는다). 복합 주장이 contradicted면 원자 주장으로 나눠 다시 검증한 결과를 쓴다.</p>
  {{ disclaimer() }}
</section>

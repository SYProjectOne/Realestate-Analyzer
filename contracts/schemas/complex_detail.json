        "official_site_url": null, "developer": "반도건설", "trustee": null, "builder": "반도건설",
        "housing_type": { "v": null, "label": "확인 불가", "reason": "공고 전", "prov": null, "checked_at": "2026-10-07" },
        "land_type": { "v": "공공택지", "label": "비공식", "prov": "fp_8801", "checked_at": "2026-10-07", "unit": "text" },

        "regulated": { "v": "비규제", "label": "확인됨", "prov": "fp_8803", "checked_at": "2026-10-07", "unit": "text" },
        "units_total": { "v": 1110, "label": "비공식", "prov": "fp_8804", "checked_at": "2026-10-07", "unit": "units" },
        "units_general": { "v": null, "label": "확인 불가", "reason": "공고 전", "prov": null, "checked_at": "2026-10-07" },
        "units_special": { "v": null, "label": "확인 불가", "reason": "공고 전", "prov": null, "checked_at": "2026-10-07" },
        "officetel_units": { "v": null, "label": "확인 불가", "reason": "공고 전", "prov": null, "checked_at": "2026-10-07" },
        "notice_date": { "v": null, "label": "확인 불가", "reason": "공고 전", "prov": null, "checked_at": "2026-10-07" },
        "apply_dates": [], "contract_dates": [],
        "winner_date": { "v": null, "label": "확인 불가", "reason": "공고 전", "prov": null, "checked_at": "2026-10-07" },
        "move_in_ym": { "v": null, "label": "확인 불가", "reason": "공고 전", "prov": null, "checked_at": "2026-10-07" },

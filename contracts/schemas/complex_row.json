{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "complex_row.json",
  "title": "ComplexRow",
  "description": "G2 단지 리스트 표 1행 — 열과 1:1 (RA §4-2): 이름(name) · 생활권(living_area_name) · 접수(intake) · 현재 구매가 범위(price_low~price_high) · 전매 종료(resale_end) · 입주(move_in_ym) · 가격 갭(gap_pct) · 종합 점수(total, rank) · 포함 분류(inclusion_class) · 마지막 변경(last_change). 나머지 필드는 FilterBar(택지유형·가격대·입주연도·전매 종료일)와 열 선택용.",
  "type": "object",
  "additionalProperties": false,
  "required": ["complex_id", "name", "living_area", "living_area_name", "track", "judge_scope", "intake", "price_low", "price_high", "price_mid", "resale_end", "move_in_ym", "gap_pct", "total", "rank", "tie_group", "unstable", "p10", "inclusion_class", "inclusion_decision", "inclusion_prob", "land_type", "price_cap", "regulated", "residency_months", "down_payment_pct", "units_total", "last_change"],
  "properties": {
    "complex_id": { "type": "integer" },
    "name": { "type": "string" },
    "name_prov": { "description": "단지 이름의 출처 id(chosen field_provenance → fp_<id>, 계약 2026-10-09.16·D21-8). 청약홈 공고 단지 = 청약홈 원문(라벨 확인됨), 트랙 (A) 공고 예정 후보 = 언론 기사(라벨 비공식). 출처 행이 없는 옛 행·시드는 키가 없다(= null — .15 이전 발행 리비전 저장본도 키 없음)", "type": ["string", "null"] },
    "name_label": { "description": "단지 이름 출처의 라벨(name_prov 행의 label). name_prov 가 없으면 없다", "anyOf": [{ "$ref": "label.json" }, { "type": "null" }] },
    "living_area": { "type": ["string", "null"] },
    "living_area_name": { "type": ["string", "null"] },
    "track": { "type": ["string", "null"], "enum": ["A", "B", null] },
    "judge_scope": { "$ref": "score_row.json#/$defs/JudgeScope" },
    "judge_scope_reason": { "description": "판정 범위 사유 문자열(계약 2026-10-09.17·D22-5) — 서버 analysis.scope.judge_scope 의 reason 그대로(파이프라인·보고서와 같은 함수). 예: '범위 경계(주소에 동 없음)'·'범위 경계(주소가 지역 법정동에 매칭 안 됨)'·'포함/제외 classify 미해결(review, 미분류)'·'포함/제외 classify 제외 클래스(public_sale)'·'분양가 미공개(공고 전)'·'원 공고 미수집'·'출처 상충 — compare 대기'(기준 타입 가격 채택 보류)·'포함 확정 · 접수 가능'·'접수 확인 불가'. **현재 사실로 계산한** 범위의 사유다 — judge_scope(점수 실행 저장값, D10-1)와 다르면 rejudge_needed=true 이고 이 사유는 재판정 뒤 범위의 사유다(발행 리비전은 발행 때 계산한 값). .16 이전 발행 리비전 저장본에는 키가 없다(= null). 표시 문구는 화면이 정하고 판단에 쓰지 않는다", "type": ["string", "null"], "maxLength": 200 },
    "rejudge_needed": { "description": "D10-1(계약 2026-10-09.6): judge_scope·rank·total 은 스냅샷 score_run 저장값. 현재 계산 범위가 저장값과 다르면 true('재판정 필요' 배지). 없으면 false.", "type": "boolean", "default": false },
    "intake": { "anyOf": [{ "$ref": "intake.json" }, { "type": "null" }] },
    "price_low": { "$ref": "fact.json" },
    "price_high": { "$ref": "fact.json" },
    "price_mid": { "$ref": "fact.json" },
    "resale_end": { "$ref": "fact.json" },
    "move_in_ym": { "$ref": "fact.json" },
    "gap_pct": { "description": "가격 갭 퍼센트(unit pct — 성분 원값, prov 'sc_<실행>_<단지>_gap.raw', 계약 2026-10-09.20 Q6). 종합 점수 성분 s_gap(0~10)이 아니다", "$ref": "fact.json" },
    "total": { "$ref": "fact.json" },
    "rank": { "x-nonfact": "§6-4 규칙으로 total(Fact, prov st_)에서 파생한 서수 메타 — 근거는 total.prov", "type": ["integer", "null"], "minimum": 1 },
    "tie_group": { "x-nonfact": "§6-4 규칙으로 total(Fact, prov st_)에서 파생한 서수 메타 — 근거는 total.prov", "type": ["integer", "null"], "minimum": 1 },
    "unstable": { "type": "boolean" },
    "p10": { "$ref": "fact.json" },
    "inclusion_class": { "$ref": "complex.json#/$defs/InclusionClass" },
    "inclusion_decision": { "type": ["string", "null"], "enum": ["auto", "review", "manual_review", null] },
    "inclusion_prob": { "$ref": "fact.json" },
    "land_type": { "$ref": "fact.json" },
    "price_cap": { "$ref": "fact.json" },
    "regulated": { "$ref": "fact.json" },
    "residency_months": { "$ref": "fact.json" },
    "down_payment_pct": { "$ref": "fact.json" },
    "down_payment_won": { "description": "계약 2026-10-09.20(D28-5 Q1): 계약금 원 금액 = 판정 기준 타입 P_mid × 현재 납부 조건 계약금 %(추정, reason '산술(P_mid × 계약금 n%)', prov = price_mid 의 prov) — 단지 상세 price.payment_amounts.down_payment_won·비교 TermsRow.down_payment_won 과 같은 함수·같은 값. 가격·비율 중 하나라도 확인 불가면 그 사유의 '확인 불가'. .20 이전 발행 리비전 저장본에는 키가 없다(= null)", "anyOf": [{ "$ref": "fact.json" }, { "type": "null" }] },
    "competition_summary": { "description": "계약 2026-10-09.20(D28-5 Q4): 경쟁률 요약(competition.json CompetitionSummary — 1순위 해당지역 최고 경쟁률·미달 주택형 수·당첨 가점). 경쟁률 행이 없는 단지는 rows 0. .20 이전 발행 리비전 저장본에는 키가 없다(= null)", "anyOf": [{ "$ref": "competition.json#/$defs/CompetitionSummary" }, { "type": "null" }] },
    "units_total": { "$ref": "fact.json" },
    "last_change": {
      "anyOf": [
        {
          "title": "LastChange", "type": "object", "additionalProperties": false, "required": ["at", "field", "severity"],
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "field": { "type": "string" },
            "severity": { "type": "string", "enum": ["info", "notice", "critical"] },
            "change_event_id": { "type": ["integer", "null"] }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "ComplexRowPage": {
      "title": "ComplexRowPage",
      "description": "목록 응답 래퍼 (RA §4-2): {items, total, snapshot_id, asof_date} + page·size·sort·scenario_id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "total", "snapshot_id", "asof_date", "page", "size"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#" } },
        "total": { "x-nonfact": "목록 건수(페이지 메타)", "type": "integer", "minimum": 0 },
        "snapshot_id": { "type": "integer" },
        "asof_date": { "type": "string", "format": "date" },
        "page": { "type": "integer", "minimum": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "sort": { "type": ["string", "null"] },
        "scenario_id": { "type": ["integer", "null"] }
      }
    }
  },
  "examples": [
    {
      "complex_id": 4, "name": "오퍼스 한강 스위첸", "name_prov": "fp_4100", "name_label": "확인됨", "living_area": "la_4", "living_area_name": "김포시", "track": "B", "judge_scope": "판정 대상", "judge_scope_reason": "포함 확정 · 접수 가능",
      "intake": { "status": "확인 불가", "path": "official_popup", "checked_at": "2026-10-07T09:14:00+09:00", "http_status": 403, "reason": "403", "evidence_url": "https://opus-switzen.com/" },
      "price_low": { "v": 626000000, "label": "확인됨", "prov": "fp_4101", "checked_at": "2026-10-07", "unit": "won" },
      "price_high": { "v": 699000000, "label": "확인됨", "prov": "fp_4102", "checked_at": "2026-10-07", "unit": "won" },
      "price_mid": { "v": 662500000, "label": "추정", "reason": "산술", "prov": "fp_4102", "checked_at": "2026-10-07", "unit": "won" },
      "resale_end": { "v": "2028-07-18", "label": "추정", "reason": "산술", "prov": "fp_4103", "checked_at": "2026-10-07", "unit": "date" },
      "move_in_ym": { "v": "2028-08", "label": "확인됨", "prov": "fp_4104", "checked_at": "2026-10-07", "unit": "ym" },
      "gap_pct": { "v": 0.0, "label": "추정", "reason": "대체·혼재 중앙", "prov": "sc_88_4_gap.raw", "checked_at": "2026-10-08", "unit": "pct" },
      "total": { "v": 4.995, "label": "추정", "prov": "st_88_4", "checked_at": "2026-10-08", "unit": "score" },
      "rank": 4, "tie_group": null, "unstable": false,
      "p10": { "v": 0.33, "label": "추정", "reason": "판정기 noul", "prov": "jl_123", "checked_at": "2026-10-07", "unit": "prob" },
      "inclusion_class": "private_sale_apt", "inclusion_decision": "review",
      "inclusion_prob": { "v": 0.72, "label": "추정", "reason": "판정기 classify", "prov": "jl_110", "checked_at": "2026-10-07", "unit": "prob" },
      "land_type": { "v": "공공택지", "label": "확인됨", "prov": "fp_4105", "checked_at": "2026-10-07", "unit": "text" },
      "price_cap": { "v": "적용", "label": "확인됨", "prov": "fp_4106", "checked_at": "2026-10-07", "unit": "text" },
      "regulated": { "v": "비규제", "label": "확인됨", "prov": "fp_4107", "checked_at": "2026-10-07", "unit": "text" },
      "residency_months": { "v": 0, "label": "확인됨", "prov": "fp_4108", "checked_at": "2026-10-07", "unit": "months" },
      "down_payment_pct": { "v": 10, "label": "확인됨", "prov": "fp_4109", "checked_at": "2026-10-07", "unit": "pct" },
      "down_payment_won": { "v": 66250000, "label": "추정", "reason": "산술(P_mid × 계약금 10%)", "prov": "fp_4102", "checked_at": "2026-10-07", "unit": "won" },
      "units_total": { "v": 1029, "label": "확인됨", "prov": "fp_4110", "checked_at": "2026-10-07", "unit": "units" },
      "last_change": null
    }
  ]
}

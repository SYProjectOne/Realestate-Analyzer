{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "complex_type.json",
  "title": "ComplexType",
  "description": "단지의 타입(평형) 1개 (RA §3 complex_type). (complex_id, type_code) 유일. 판정 기준 타입은 전용 84㎡에 가장 가까운 것(is_basis=true, 동률이면 type_code 사전순 첫째).\n현재 구매가(RA §6-1): P_low = floor_sample_price_won + balcony_won + options_required_won, P_high = max_price_won + balcony_won + options_required_won, P_mid = (P_low + P_high)/2. 할인은 label=확인됨인 것만 뺀다. 임의공급에서 가격이 바뀌면 최신 payment_terms.effective_from 공고의 값.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type_code", "area_m2", "units", "max_price_won", "floor_sample_price_won", "balcony_won", "options_required_won", "is_basis"],
  "properties": {
    "id": { "type": ["integer", "null"] },
    "complex_id": { "type": ["integer", "null"] },
    "type_code": { "description": "공고문 표기 그대로(예 '84A', '84.9582A'를 정규화한 '84A')", "type": "string", "minLength": 1, "maxLength": 16 },
    "area_m2": { "description": "전용면적 ㎡ 소수 2자리", "$ref": "fact.json" },
    "units": { "$ref": "fact.json" },
    "max_price_won": { "description": "공급금액 최고가(원)", "$ref": "fact.json" },
    "floor_sample_price_won": { "description": "공고문 표의 대표 층 공급금액(원)", "$ref": "fact.json" },
    "floor_sample_text": { "description": "대표 층 원문(예 '3층', '1층 5.91억')", "type": ["string", "null"] },
    "balcony_won": { "description": "발코니 확장비(원). 무상이면 v=0", "$ref": "fact.json" },
    "options_required_won": { "description": "필수 옵션 합계(원). 없으면 v=0", "$ref": "fact.json" },
    "options_text": { "type": ["string", "null"] },
    "is_basis": { "description": "판정 기준 타입(84㎡에 가장 가까움)", "type": "boolean" }
  },
  "examples": [
    {
      "id": 31, "complex_id": 2, "type_code": "84A",
      "area_m2": { "v": 84.98, "label": "확인됨", "prov": "fp_2101", "checked_at": "2026-10-07", "unit": "m2" },
      "units": { "v": 2, "label": "확인됨", "reason": "임의공급 3차 잔여", "prov": "fp_2102", "checked_at": "2026-10-07", "unit": "units" },
      "max_price_won": { "v": 605000000, "label": "확인됨", "prov": "fp_2103", "checked_at": "2026-10-07", "unit": "won" },
      "floor_sample_price_won": { "v": 575000000, "label": "확인됨", "prov": "fp_2104", "checked_at": "2026-10-07", "unit": "won" },
      "floor_sample_text": "3층",
      "balcony_won": { "v": 3140000, "label": "확인됨", "prov": "fp_2105", "checked_at": "2026-10-07", "unit": "won" },
      "options_required_won": { "v": 0, "label": "확인됨", "prov": "fp_2106", "checked_at": "2026-10-07", "unit": "won" },
      "options_text": null, "is_basis": true
    }
  ]
}

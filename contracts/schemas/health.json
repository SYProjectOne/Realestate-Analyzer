{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health.json",
  "title": "Health",
  "description": "GET /health — 인증 없음. docker compose 헬스체크와 화면 전역 배너용. status=degraded면 db 또는 judge 중 하나가 정상이 아니다(판정기 장애 시 수집·조회는 계속된다). contract_version은 이 서버가 구현한 계약 버전(contracts/CHANGELOG.md 최신 항목).",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "contract_version", "app_version", "db", "judge", "time"],
  "properties": {
    "status": { "type": "string", "enum": ["ok", "degraded"] },
    "contract_version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" },
    "app_version": { "type": "string" },
    "db": { "type": "string", "enum": ["ok", "error"] },
    "judge": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
    "time": { "type": "string", "format": "date-time" }
  },
  "examples": [
    { "status": "ok", "contract_version": "2026-10-09.1", "app_version": "0.1.0", "db": "ok", "judge": "unknown", "time": "2026-10-09T09:00:00+09:00" }
  ]
}

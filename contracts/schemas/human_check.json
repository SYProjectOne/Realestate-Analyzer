{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human_check.json",
  "title": "HumanCheck",
  "description": "사람 확인 1건 (RA §3 human_check) — G7 HumanCheckForm. field='intake_status'이면 value_text는 접수 상태(가능/미정/확인 불가/불가)이고, 서버가 같은 스냅샷에 intake_status 행(path=human_check)과 change_event(critical, triggers_rejudge)를 만들고 rejudge 잡을 제안한다(T3). entered_by는 역할 문자열만(EnteredByRole: 운영자·검토자), 사람 이름 금지. 통화 내용은 요약만.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "complex_id", "field", "value_text", "kind", "checked_at", "entered_by", "note"],
  "properties": {
    "id": { "type": "integer" },
    "complex_id": { "type": "integer" },
    "field": { "type": "string", "minLength": 1, "maxLength": 64 },
    "value_text": { "type": "string" },
    "kind": { "type": "string", "enum": ["phone", "visit", "email"] },
    "checked_at": { "type": "string" },
    "entered_by": { "type": "string", "maxLength": 32 },
    "note": { "type": ["string", "null"] },
    "created_intake": { "anyOf": [{ "$ref": "intake.json" }, { "type": "null" }] },
    "change_event_id": { "type": ["integer", "null"] },
    "suggested_job": {
      "anyOf": [
        { "$ref": "job_run.json#/$defs/JobCreate" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "EnteredByRole": {
      "title": "EnteredByRole",
      "description": "사람 확인 입력자 = 역할 문자열만(RA §10 보안 2 — 사람 이름 금지, 계약 2026-10-09.4). 자유 입력을 받지 않는다. 옛 행(자유 문자열)은 응답 HumanCheck.entered_by 에 그대로 나갈 수 있다.",
      "type": "string",
      "enum": ["운영자", "검토자"]
    },
    "HumanCheckCreate": {
      "title": "HumanCheckCreate",
      "description": "POST /ops/human-checks 본문",
      "type": "object",
      "additionalProperties": false,
      "required": ["complex_id", "field", "value_text", "kind", "checked_at", "entered_by"],
      "properties": {
        "complex_id": { "type": "integer" },
        "field": { "type": "string", "minLength": 1, "maxLength": 64 },
        "value_text": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["phone", "visit", "email"] },
        "checked_at": { "type": "string", "minLength": 10 },
        "entered_by": { "$ref": "#/$defs/EnteredByRole" },
        "note": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "field": { "const": "intake_status" } } },
          "then": { "properties": { "value_text": { "enum": ["가능", "미정", "확인 불가", "불가"] } } }
        }
      ]
    }
  },
  "examples": [
    {
      "id": 3, "complex_id": 4, "field": "intake_status", "value_text": "가능", "kind": "phone", "checked_at": "2026-10-09T10:20:00+09:00",
      "entered_by": "운영자", "note": "분양사무소 통화: 선착순 동·호지정 계약 가능, 조건은 공고문과 같다고 안내",
      "created_intake": { "id": 640, "complex_id": 4, "snapshot_id": 12, "status": "가능", "path": "human_check", "evidence_url": null, "screenshot_path": null, "raw_document_id": null, "checked_at": "2026-10-09T10:20:00+09:00", "http_status": null, "reason": null, "note": "분양사무소 통화", "entered_by": "운영자" },
      "change_event_id": 3310,
      "suggested_job": { "job_name": "rejudge", "payload": { "snapshot_id": 12, "scenario_id": null, "complex_ids": [4], "reason": "사람 확인 입력: 오퍼스 한강 스위첸 접수 가능" } }
    }
  ]
}

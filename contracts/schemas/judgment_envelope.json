{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judgment_envelope.json",
  "title": "JudgmentEnvelope",
  "description": "판정기 호출 1건의 봉투 (RA §4-1, judgment_log 행의 API 모양). JudgeAdapter의 9개 메서드가 모두 이것을 돌려준다.\n- status: ok(판정기 auto 결정) / review(판정기가 사람 검토로 넘김: review·escalate·manual_review·invalid_response 포함) / escaped(decide escape hatch: ask_user·investigate 선택, 질문을 남김) / blocked(guard 또는 screen block으로 호출 거부) / error(판정기 오류·미수신, JudgeUnavailable).\n- status가 review·escaped·blocked·error이면 result는 표시만 하고 점수·추천에 쓰지 않는다 — 거르는 곳은 프론트가 아니라 WP4(analysis).\n- cached=true는 같은 input_hash의 이전 행을 돌려준 것. 화면은 '캐시' 배지.\n- input_hash = 'sha256:' + hex(sha256(canonical JSON {tool, purpose, payload, adapter_version})). canonical JSON = 키 정렬, 구분자 (',', ':'), ensure_ascii=false, UTF-8.\n- adapter_version = '<어댑터 코드 버전>+jev-mcp@<서버 버전>' (DECISIONS D6).\n- result는 도구별 정규화 결과($defs의 <Tool>Result), raw는 판정기 원응답 그대로(임계값·decision 포함, DECISIONS D6).\n- 로그에는 payload 원문을 남기지 않는다(input_hash·길이만, AGENTS 13).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "purpose", "input_hash", "status", "confidence", "cached", "result", "raw", "duration_ms", "judgment_seq", "created_at"],
  "properties": {
    "tool": { "$ref": "#/$defs/JudgeTool" },
    "purpose": {
      "description": "호출 목적 키. 예: 'screen:notice:<complex_id>', 'extract:notice:<complex_id>', 'noul:ladder:move_in_plus_1y', 'rerank:region', 'decide:scenario_B', 'verify:section_8'. 같은 payload라도 purpose가 다르면 다른 input_hash.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "input_len": { "description": "canonical payload 길이(문자 수). 로그용", "type": ["integer", "null"] },
    "status": { "type": "string", "enum": ["ok", "review", "escaped", "blocked", "error"] },
    "confidence": { "description": "판정기가 준 신뢰도 0~1. 없으면 null", "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "cached": { "type": "boolean" },
    "result": { "description": "도구별 정규화 결과 ($defs의 ScreenResult … VerifyResult). error·blocked면 {}.", "type": "object" },
    "raw": { "description": "판정기 원응답(JSON). 임계값·decision을 포함해 그대로 저장. blocked면 {\"reason\": …}.", "type": "object" },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "judgment_seq": { "description": "judgment_log.seq. 성공·실패 불문 모든 호출이 행을 가진다", "type": ["integer", "null"] },
    "created_at": { "description": "ISO 8601 시각", "type": "string", "minLength": 10 },
    "adapter_version": { "type": ["string", "null"], "maxLength": 64 },
    "snapshot_id": { "type": ["integer", "null"] },
    "complex_id": { "type": ["integer", "null"] },
    "error_text": { "description": "status=error·blocked 사유. payload 원문 금지", "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "tool": { "const": "screen" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/ScreenResult" } } } },
    { "if": { "properties": { "tool": { "const": "extract" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/ExtractResult" } } } },
    { "if": { "properties": { "tool": { "const": "audit" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/AuditResult" } } } },
    { "if": { "properties": { "tool": { "const": "classify" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/ClassifyResult" } } } },
    { "if": { "properties": { "tool": { "const": "compare" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/CompareResult" } } } },
    { "if": { "properties": { "tool": { "const": "noul" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/NoulResult" } } } },
    { "if": { "properties": { "tool": { "const": "rerank" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/RerankResult" } } } },
    { "if": { "properties": { "tool": { "const": "decide" }, "status": { "enum": ["ok", "escaped"] } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/DecideResult" } } } },
    { "if": { "properties": { "tool": { "const": "verify" }, "status": { "const": "ok" } }, "required": ["tool", "status"] }, "then": { "properties": { "result": { "$ref": "#/$defs/VerifyResult" } } } }
  ],
  "$defs": {
    "JudgeTool": {
      "title": "JudgeTool",
      "description": "판정기 도구 9종 (JEV: jev_<tool>). find·gate·review는 미사용(DECISIONS D6).",
      "type": "string",
      "enum": ["screen", "extract", "audit", "classify", "compare", "noul", "rerank", "decide", "verify"]
    },
    "Verdict3": {
      "title": "Verdict3",
      "description": "noul 명제 판정. likely(≥auto 임계, 예 0.85) / uncertain / unlikely(≤0.15)",
      "type": "string",
      "enum": ["likely", "uncertain", "unlikely"]
    },
    "ScreenResult": {
      "title": "ScreenResult",
      "description": "P1 입력 검사. verdict=block이면 그 입력은 사용 금지, skip이면 purpose를 바꿔 다른 입력으로 재스크린.",
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string", "enum": ["pass", "skip", "block"] },
        "injection": { "type": ["number", "null"] },
        "substance": { "type": ["number", "null"] },
        "relevance": { "type": ["number", "null"] }
      }
    },
    "ExtractResult": {
      "title": "ExtractResult",
      "description": "P2 수치 추출. review 필드는 공고문 원문값을 쓰고 'review' 표기.",
      "type": "object",
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "title": "ExtractedField",
            "type": "object",
            "required": ["name", "value_text", "decision"],
            "properties": {
              "name": { "type": "string" },
              "value_text": { "type": ["string", "null"] },
              "decision": { "type": "string", "enum": ["auto", "review"] },
              "confidence": { "type": ["number", "null"] },
              "excerpt": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "AuditResult": {
      "title": "AuditResult",
      "description": "P3 감사. flagged 항목은 원문 대조 후 수정.",
      "type": "object",
      "required": ["verdict", "items"],
      "properties": {
        "verdict": { "type": "string", "enum": ["pass", "flagged"] },
        "items": {
          "type": "array",
          "items": {
            "title": "AuditItem",
            "type": "object",
            "required": ["field", "p_wrong", "flagged"],
            "properties": {
              "field": { "type": "string" },
              "p_wrong": { "type": "number" },
              "flagged": { "type": "boolean" },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "ClassifyResult": {
      "title": "ClassifyResult",
      "description": "P4 분류. 포함/제외 7클래스(private_sale_apt, public_sale, public_rental, private_rental, non_apartment, out_of_scope, manual_review) 또는 호재 단계 5클래스(확정, 계획, 추진, 언론, 미확정). decision=review면 미해결.",
      "type": "object",
      "required": ["label", "prob", "decision"],
      "properties": {
        "label": { "type": "string" },
        "prob": { "type": "number" },
        "decision": { "type": "string", "enum": ["auto", "review", "manual_review"] },
        "distribution": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "CompareResult": {
      "title": "CompareResult",
      "description": "P5 출처 충돌. contradicts면 1차 자료 채택·2차 병기, 둘 다 2차면 병기·판정 미사용.",
      "type": "object",
      "required": ["overall"],
      "properties": {
        "overall": { "type": "string", "enum": ["same_fact", "contradicts", "different_facts", "review"] },
        "prob": { "type": ["number", "null"] },
        "aspects": {
          "type": "array",
          "items": {
            "title": "CompareAspect",
            "type": "object",
            "required": ["aspect", "relation"],
            "properties": {
              "aspect": { "type": "string" },
              "relation": { "type": "string", "enum": ["same_fact", "contradicts", "different_facts", "review"] },
              "prob": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "NoulResult": {
      "title": "NoulResult",
      "description": "P6 상승 확률 사다리. 명제 4개(p5, p10, p20, p_flat) 고정 템플릿(meta §2-2), horizon 1개당 호출 1회.",
      "type": "object",
      "required": ["horizon", "target_ym", "propositions"],
      "properties": {
        "horizon": { "type": "string", "enum": ["move_in_plus_1y", "asof_plus_3y", "asof_plus_5y"] },
        "target_ym": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "propositions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "title": "NoulProposition",
            "type": "object",
            "required": ["key", "text", "prob", "verdict"],
            "properties": {
              "key": { "type": "string", "enum": ["p5", "p10", "p20", "p_flat"] },
              "text": { "type": "string" },
              "prob": { "type": "number", "minimum": 0, "maximum": 1 },
              "verdict": { "$ref": "#/$defs/Verdict3" },
              "decision": { "type": ["string", "null"], "enum": ["auto", "review", null] }
            }
          }
        }
      }
    },
    "RerankResult": {
      "title": "RerankResult",
      "description": "P7 상대 순위. 한 호출 안의 순위만 비교 가능(§6-5 고정 앵커). candidate_id는 'complex:<id>'.",
      "type": "object",
      "required": ["query", "items"],
      "properties": {
        "query": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/RerankItem" } }
      }
    },
    "RerankItem": {
      "title": "RerankItem",
      "description": "rerank 후보 1개. candidate_id = 'complex:<id>'.",
      "type": "object",
      "required": ["candidate_id", "relevance", "rank"],
      "properties": {
        "candidate_id": { "type": "string" },
        "complex_id": { "type": ["integer", "null"] },
        "relevance": { "type": "number" },
        "rank": { "type": "integer", "minimum": 1 }
      }
    },
    "DecideResult": {
      "title": "DecideResult",
      "description": "P8 상황별 결정. options는 후보 ≤6 + escape hatch(ask_user, investigate, none). checks는 option_id별 요건 3개(access, regulation, funds)의 supported/contradicted/unknown. escaped=true면 question에 판정기의 질문.",
      "type": "object",
      "required": ["selected", "probs", "escaped"],
      "properties": {
        "selected": { "type": ["string", "null"] },
        "probs": { "type": "object", "additionalProperties": { "type": "number" } },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "access": { "type": "string", "enum": ["supported", "contradicted", "unknown"] },
              "regulation": { "type": "string", "enum": ["supported", "contradicted", "unknown"] },
              "funds": { "type": "string", "enum": ["supported", "contradicted", "unknown"] }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "escaped": { "type": "boolean" },
        "question": { "type": ["string", "null"] }
      }
    },
    "VerifyResult": {
      "title": "VerifyResult",
      "description": "P9 검증. 주장 ≤16건, 원자 주장만(ClaimSplitter). contradicted가 남으면 snapshot publish 불가.",
      "type": "object",
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "title": "VerifiedClaim",
            "type": "object",
            "required": ["claim_id", "verdict"],
            "properties": {
              "claim_id": { "type": "string" },
              "verdict": { "type": "string", "enum": ["verified", "contradicted", "unsupported", "review"] },
              "confidence": { "type": ["number", "null"] },
              "action": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "tool": "decide", "purpose": "decide:scenario_B", "input_hash": "sha256:5b1f0e6a3c2d4b8e9f7a6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f",
      "input_len": 6120, "status": "ok", "confidence": 0.48, "cached": true,
      "result": {
        "selected": "complex:7",
        "probs": { "complex:7": 0.54, "complex:2": 0.42, "complex:3": 0.01, "complex:4": 0.01, "complex:1": 0.0, "complex:5": 0.0, "ask_user": 0.01, "investigate": 0.01 },
        "checks": {
          "complex:7": { "access": "supported", "regulation": "supported", "funds": "supported" },
          "complex:2": { "access": "supported", "regulation": "supported", "funds": "supported" },
          "complex:4": { "access": "unknown", "regulation": "supported", "funds": "contradicted" }
        },
        "warnings": [], "escaped": false, "question": null
      },
      "raw": { "selected": "cantavil", "confidence": 0.48, "escaped": false, "thresholds": { "auto_accept": 0.6 } },
      "duration_ms": 1830, "judgment_seq": 127, "created_at": "2026-10-07T15:41:00+09:00",
      "adapter_version": "0.1.0+jev-mcp@1.13.0", "snapshot_id": 12, "complex_id": null, "error_text": null
    }
  ]
}

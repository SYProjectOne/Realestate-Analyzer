{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payment_terms.json",
  "title": "PaymentTerms",
  "description": "공고별 납부 조건 1행 (RA §3 payment_terms). (complex_id, notice_no) 유일. 최신 effective_from 행이 현재 조건(is_current=true)이고, 최초 공고 대비 증감은 계산해 change_vs_first에 둔다(임의공급 계약금 10%→5% 같은 변경, T9). pct 값은 퍼센트 숫자(5 = 5%).",
  "type": "object",
  "additionalProperties": false,
  "required": ["notice_no", "effective_from", "down_payment_pct", "down_payment_first_won", "interim_pct", "balance_pct", "interim_schedule", "is_current"],
  "properties": {
    "id": { "type": ["integer", "null"] },
    "complex_id": { "type": ["integer", "null"] },
    "notice_no": { "description": "청약홈 주택관리번호/공고번호", "type": "string", "maxLength": 32 },
    "notice_kind": { "type": ["string", "null"], "enum": ["본청약", "무순위", "임의", "선착순", null] },
    "effective_from": { "description": "이 조건이 적용되는 공고일 YYYY-MM-DD", "$ref": "fact.json" },
    "down_payment_pct": { "$ref": "fact.json" },
    "down_payment_first_won": { "description": "1차 계약금 정액(원). 정액 표기가 없으면 확인 불가", "$ref": "fact.json" },
    "interim_pct": { "$ref": "fact.json" },
    "interim_terms_text": { "description": "중도금 조건 원문(무이자·이자후불제·이자 대납 등)", "type": ["string", "null"] },
    "balance_pct": { "$ref": "fact.json" },
    "interim_schedule": {
      "type": "array",
      "items": {
        "title": "InterimInstallment",
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "due_date", "pct"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "due_date": { "$ref": "fact.json" },
          "pct": { "$ref": "fact.json" }
        }
      }
    },
    "is_current": { "type": "boolean" },
    "price_by_type": {
      "description": "이 공고의 타입별 공급가(임의공급·무순위는 공고마다 가격이 바뀐다, 2026-10-09.2). 키 = complex_type.type_code. 현재 구매가(complex_type 가격)는 is_current 행의 값이고, change_vs_first.price_change_pct 는 판정 기준 타입(84㎡에 가장 가까움)의 max_price_won 으로 계산한다. 출처 행은 field_provenance(entity='payment_terms', field='price_by_type.<type_code>.<항목>'). 공고에 가격 표가 없으면 {}",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/NoticeTypePrice" }
    },
    "discount_by_type": {
      "description": "이 공고에 명시된 할인(타입별, 원 단위 — 계약 2026-10-09.8, D11-6). 키 = complex_type.type_code. 공고문·청약홈에 할인 금액이 적힌 것만(추정 금지). 출처 행은 field_provenance(entity='payment_terms', field='discount_by_type.<type_code>'). §6-1 구매가 차감은 라벨 확인됨일 때만. 없으면 {}",
      "type": "object",
      "additionalProperties": { "$ref": "fact.json" }
    },
    "change_vs_first": {
      "description": "최초 공고 대비 증감(최초 행이면 null). down_payment_pct_delta는 %p, price_change_pct는 기준 타입 최고가 증감률 %",
      "anyOf": [
        {
          "title": "PaymentChange",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "down_payment_pct_delta": { "anyOf": [{ "$ref": "fact.json" }, { "type": "null" }] },
            "price_change_pct": { "anyOf": [{ "$ref": "fact.json" }, { "type": "null" }] }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "NoticeTypePrice": {
      "title": "NoticeTypePrice",
      "description": "공고 1건의 타입 1개 공급가. 값 정의는 complex_type 의 같은 이름 필드와 같다(원 단위). DB(payment_terms.price_by_type json)에는 맨값 {max_price_won, floor_sample_price_won, floor_sample_text, units}으로 저장하고 API는 Fact로 낸다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_price_won", "floor_sample_price_won"],
      "properties": {
        "notice_type_code": { "description": "공고 표기 주택형(예 '084.9582A')", "type": ["string", "null"] },
        "units": { "description": "이 공고의 공급 세대수", "anyOf": [{ "$ref": "fact.json" }, { "type": "null" }] },
        "max_price_won": { "$ref": "fact.json" },
        "floor_sample_price_won": { "$ref": "fact.json" },
        "floor_sample_text": { "type": ["string", "null"] }
      }
    }
  },
  "examples": [
    {
      "id": 77, "complex_id": 7, "notice_no": "2026940116", "notice_kind": "임의",
      "effective_from": { "v": "2026-06-05", "label": "확인됨", "prov": "fp_4410", "checked_at": "2026-10-07", "unit": "date" },
      "down_payment_pct": { "v": 5, "label": "확인됨", "prov": "fp_4411", "checked_at": "2026-10-07", "unit": "pct" },
      "down_payment_first_won": { "v": null, "label": "확인 불가", "reason": "정액 표기 없음", "prov": null, "checked_at": "2026-10-07" },
      "interim_pct": { "v": 60, "label": "확인됨", "prov": "fp_4412", "checked_at": "2026-10-07", "unit": "pct" },
      "interim_terms_text": "중도금 60%(6회, 2026-07-24~2029-05-25) 이자후불제",
      "balance_pct": { "v": 35, "label": "확인됨", "prov": "fp_4413", "checked_at": "2026-10-07", "unit": "pct" },
      "interim_schedule": [
        { "seq": 1, "due_date": { "v": "2026-07-24", "label": "확인됨", "prov": "fp_4414", "checked_at": "2026-10-07", "unit": "date" }, "pct": { "v": 10, "label": "확인됨", "prov": "fp_4414", "checked_at": "2026-10-07", "unit": "pct" } }
      ],
      "is_current": true,
      "price_by_type": {
        "84B": {
          "notice_type_code": "084.7529B",
          "units": { "v": 2, "label": "확인됨", "prov": "fp_4416", "checked_at": "2026-10-07", "unit": "units" },
          "max_price_won": { "v": 642000000, "label": "확인됨", "prov": "fp_4417", "checked_at": "2026-10-07", "unit": "won" },
          "floor_sample_price_won": { "v": 618000000, "label": "확인됨", "prov": "fp_4418", "checked_at": "2026-10-07", "unit": "won" },
          "floor_sample_text": "3층"
        }
      },
      "change_vs_first": {
        "down_payment_pct_delta": { "v": -5, "label": "추정", "reason": "산술", "prov": "fp_4411", "checked_at": "2026-10-07", "unit": "pct" },
        "price_change_pct": { "v": 0, "label": "추정", "reason": "산술", "prov": "fp_4415", "checked_at": "2026-10-07", "unit": "pct" }
      }
    }
  ]
}

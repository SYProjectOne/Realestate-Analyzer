{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.json",
  "title": "Provenance",
  "description": "GET /provenance/{prov_id} — 공통 출처 패널 (RA §4-2). prov_id 접두어로 kind가 정해진다: fp_=field(field_provenance 행 + 원문 발췌 + 상충 그룹), sc_=score_component(formula_text), st_=score_total(가중 합 식), jl_=judgment(judgment_log 행 요약), hc_=human_check, rd_=raw_document, cs_=comparable_set.\nexcerpt_start/end는 raw_document text 안의 오프셋 — G3 ProvenanceTab이 /raw/{raw_document_id}의 txt에서 하이라이트한다. conflicts는 같은 conflict_group의 다른 후보(chosen=false 포함)로, 출처 패널은 둘 다 보여준다(T5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "label", "url", "checked_at", "excerpt", "raw_document_id", "conflicts"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "type": "string", "enum": ["field", "score_component", "score_total", "judgment", "human_check", "raw_document", "comparable_set"] },
    "entity": { "type": ["string", "null"] },
    "entity_id": { "type": ["integer", "null"] },
    "field": { "type": ["string", "null"] },
    "value_text": { "type": ["string", "null"] },
    "label": { "$ref": "label.json" },
    "reason": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"] },
    "checked_at": { "type": ["string", "null"] },
    "excerpt": { "type": ["string", "null"] },
    "excerpt_start": { "type": ["integer", "null"] },
    "excerpt_end": { "type": ["integer", "null"] },
    "raw_document_id": { "type": ["integer", "null"] },
    "source_kind": { "anyOf": [{ "$ref": "raw_document.json#/$defs/SourceKind" }, { "type": "null" }] },
    "http_status": { "type": ["integer", "null"] },
    "source_rank": { "type": ["integer", "null"] },
    "chosen": { "type": ["boolean", "null"] },
    "conflict_group": { "type": ["string", "null"] },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/ProvenanceConflict" } },
    "formula_text": { "type": ["string", "null"] },
    "judgment_seq": { "type": ["integer", "null"] },
    "compare_judgment_seq": { "description": "상충을 compare로 판정했으면 그 호출", "type": ["integer", "null"] }
  },
  "$defs": {
    "ProvenanceConflict": {
      "title": "ProvenanceConflict",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value_text", "label", "url", "checked_at", "source_rank", "chosen"],
      "properties": {
        "id": { "type": "string" },
        "value_text": { "type": ["string", "null"] },
        "label": { "$ref": "label.json" },
        "reason": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "checked_at": { "type": ["string", "null"] },
        "source_kind": { "anyOf": [{ "$ref": "raw_document.json#/$defs/SourceKind" }, { "type": "null" }] },
        "source_rank": { "type": "integer" },
        "chosen": { "type": "boolean" },
        "excerpt": { "type": ["string", "null"] },
        "raw_document_id": { "type": ["integer", "null"] }
      }
    }
  },
  "examples": [
    {
      "id": "fp_13001", "kind": "field", "entity": "complex", "entity_id": 13, "field": "units_total", "value_text": "1,573",
      "label": "확인됨", "reason": null, "url": "https://www.applyhome.co.kr/", "checked_at": "2026-10-07",
      "excerpt": "공급세대수 1,573세대", "excerpt_start": 1180, "excerpt_end": 1193, "raw_document_id": 9101,
      "source_kind": "applyhome_detail", "http_status": 200, "source_rank": 1, "chosen": true, "conflict_group": "complex:13:units_total",
      "conflicts": [
        { "id": "fp_13002", "value_text": "1,769", "label": "확인됨", "reason": null, "url": "https://www.applyhome.co.kr/", "checked_at": "2026-10-07", "source_kind": "notice_pdf", "source_rank": 2, "chosen": false, "excerpt": "총 1,769세대", "raw_document_id": 9102 }
      ],
      "formula_text": null, "judgment_seq": null, "compare_judgment_seq": null
    }
  ]
}

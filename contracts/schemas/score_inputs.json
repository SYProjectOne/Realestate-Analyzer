{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score_inputs.json",
  "title": "ScoreInputs",
  "description": "ScoreEngine.run(snapshot, scenario, inputs)의 입력 (RA §4-3, §6). DB에서 읽어 만드는 쪽은 WP7(scheduler)·WP5, 계산은 WP4(analysis)가 순수 함수로 한다 — 같은 inputs면 같은 결과.\n판정 값은 봉투 형태 그대로(status·judgment_seq 포함) 넣고, status가 ok가 아닌 값을 걸러내는 것은 WP4다.\n비교군 선택(같은 생활권, 준공 2020년 이후, 전용 80~85㎡, 기준일 이전 6개월, cancelled=false, Open API 우선, 3건 미만이면 대체, 이상치 1.5×IQR 제외)도 WP4의 규칙이므로 trades에는 생활권의 거래를 걸러내지 않고 넣는다.\nfixed_components는 회귀 (a)단계 전용(RA §9): 주어진 성분은 식을 건너뛰고 그 점수를 그대로 쓴다(formula_text '고정 입력: <출처>').",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "asof_date", "region", "rerank", "living_areas", "trades", "benchmarks", "supply", "unsold", "complexes"],
  "properties": {
    "snapshot_id": { "type": "integer" },
    "asof_date": { "type": "string", "format": "date" },
    "region": {
      "title": "RegionScoreParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["age_premium_coef", "supply_ref_pct"],
      "properties": {
        "age_premium_coef": { "$ref": "region.json#/$defs/AgePremiumCoef" },
        "supply_ref_pct": { "type": "number" }
      }
    },
    "rerank": { "$ref": "#/$defs/RerankAnchor" },
    "living_areas": {
      "type": "array",
      "items": {
        "title": "LivingAreaScoreInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "households"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "households": { "type": ["integer", "null"], "minimum": 0 },
          "unsold_scope_codes": {
            "description": "이 생활권에 해당하는 미분양 통계 범위 코드(UnsoldInput.scope_code, 시군구 5자리) 목록 — 생활권 법정동의 sigungu_code 집합(2026-10-09.2, WP4). 비어 있으면 미분양은 '지역 합계'로 본다",
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    },
    "trades": { "type": "array", "items": { "$ref": "#/$defs/TradeInput" } },
    "benchmarks": { "type": "array", "items": { "$ref": "#/$defs/BenchmarkInput" } },
    "supply": {
      "type": "array",
      "items": {
        "title": "SupplyInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["living_area", "year", "units", "label"],
        "properties": {
          "living_area": { "type": ["string", "null"] },
          "year": { "type": "integer" },
          "ym": { "description": "월 단위 입주월이 있으면 YYYY-MM (±12개월 창 계산용)", "type": ["string", "null"] },
          "units": { "type": "integer", "minimum": 0 },
          "label": { "$ref": "label.json" },
          "complex_id": { "type": ["integer", "null"] }
        }
      }
    },
    "unsold": {
      "type": "array",
      "items": {
        "title": "UnsoldInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["ym", "total", "post_completion"],
        "properties": {
          "ym": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "scope_code": { "type": ["string", "null"] },
          "total": { "type": ["integer", "null"] },
          "post_completion": { "type": ["integer", "null"] },
          "label": { "anyOf": [{ "$ref": "label.json" }, { "type": "null" }] }
        }
      }
    },
    "complexes": { "type": "array", "items": { "$ref": "#/$defs/ComplexScoreInput" } }
  },
  "$defs": {
    "RerankAnchor": {
      "title": "RerankAnchor",
      "description": "§6-5 고정 앵커: 이 run의 rerank는 judgment_seq 한 호출의 items만 쓴다. prev가 있으면 delta_rerank = relevance − prev relevance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["judgment_seq", "status", "items"],
      "properties": {
        "judgment_seq": { "type": ["integer", "null"] },
        "status": { "type": "string", "enum": ["ok", "review", "escaped", "blocked", "error"] },
        "items": { "type": "array", "items": { "$ref": "judgment_envelope.json#/$defs/RerankItem" } },
        "prev": {
          "anyOf": [
            {
              "title": "RerankPrev", "type": "object", "additionalProperties": false, "required": ["judgment_seq", "items"],
              "properties": {
                "judgment_seq": { "type": ["integer", "null"] },
                "items": { "type": "array", "items": { "$ref": "judgment_envelope.json#/$defs/RerankItem" } }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "TradeInput": {
      "title": "TradeInput",
      "description": "rtms_trade 1행(생활권 단위로 걸러지지 않은 원자료). source=reprocessed 행은 같은 단지에 openapi 행이 있으면 쓰지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["living_area", "apt_name", "completed_year", "area_m2", "price_won", "deal_date", "cancelled", "source"],
      "properties": {
        "id": { "type": ["integer", "null"] },
        "living_area": { "type": ["string", "null"] },
        "apt_name": { "type": "string" },
        "completed_year": { "type": ["integer", "null"] },
        "area_m2": { "type": "number" },
        "floor": { "type": ["integer", "null"] },
        "price_won": { "type": "integer", "minimum": 0 },
        "deal_date": { "type": "string", "format": "date" },
        "cancelled": { "type": "boolean" },
        "source": { "type": "string", "enum": ["openapi", "reprocessed"] },
        "is_presale": { "description": "분양권 거래(벤치마크·비교군 아님, '현재 프리미엄 추정'에만)", "type": "boolean", "default": false }
      }
    },
    "BenchmarkInput": {
      "title": "BenchmarkInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["living_area", "name", "sale_year", "sale_price_84_won", "trade_median_won", "is_presale", "label"],
      "properties": {
        "id": { "type": ["integer", "null"] },
        "living_area": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "completed_year": { "type": ["integer", "null"] },
        "sale_year": { "type": ["integer", "null"] },
        "sale_price_84_won": { "type": ["integer", "null"] },
        "trade_median_won": { "type": ["integer", "null"] },
        "is_presale": { "type": "boolean" },
        "label": { "$ref": "label.json" }
      }
    },
    "LadderInput": {
      "title": "LadderInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon", "target_ym", "months_from_asof", "p5", "p10", "p20", "p_flat", "status", "judgment_seq"],
      "properties": {
        "horizon": { "type": "string", "enum": ["move_in_plus_1y", "asof_plus_3y", "asof_plus_5y"] },
        "target_ym": { "type": "string" },
        "months_from_asof": { "type": "integer" },
        "p5": { "type": ["number", "null"] },
        "p10": { "type": ["number", "null"] },
        "p20": { "type": ["number", "null"] },
        "p_flat": { "type": ["number", "null"] },
        "status": { "type": "string", "enum": ["ok", "review", "escaped", "blocked", "error"] },
        "judgment_seq": { "type": ["integer", "null"] }
      }
    },
    "FixedComponents": {
      "title": "FixedComponents",
      "description": "회귀 (a)단계 고정 성분 점수(0~10). source는 formula_text에 들어갈 출처 문자열.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "p10": { "type": ["number", "null"] },
        "rerank": { "type": ["number", "null"] },
        "gap": { "type": ["number", "null"] },
        "benchmark": { "type": ["number", "null"] },
        "supply": { "type": ["number", "null"] },
        "liquidity": { "type": ["number", "null"] },
        "move_in": { "type": ["number", "null"] }
      }
    },
    "ComplexScoreInput": {
      "title": "ComplexScoreInput",
      "description": "단지 1개의 점수 입력. 가격은 판정 기준 타입(84㎡에 가장 가까운 타입)의 현재 구매가(§6-1). 날짜는 ISO 문자열.",
      "type": "object",
      "additionalProperties": false,
      "required": ["complex_id", "name", "living_area", "judge_scope", "price_low_won", "price_high_won", "move_in_ym", "ladders", "winner_date", "resale_months", "resale_release_on_registration", "residency_months", "down_payment_pct", "intake_status", "intake_path"],
      "properties": {
        "complex_id": { "type": "integer" },
        "name": { "type": "string" },
        "living_area": { "type": ["string", "null"] },
        "judge_scope": { "$ref": "score_row.json#/$defs/JudgeScope" },
        "price_low_won": { "type": ["integer", "null"] },
        "price_high_won": { "type": ["integer", "null"] },
        "price_label": { "anyOf": [{ "$ref": "label.json" }, { "type": "null" }] },
        "move_in_ym": { "type": ["string", "null"] },
        "immediate_move_in": { "type": "boolean", "default": false },
        "completed_year": { "type": ["integer", "null"] },
        "ladders": { "type": "array", "items": { "$ref": "#/$defs/LadderInput" } },
        "winner_date": { "type": ["string", "null"] },
        "resale_months": { "type": ["integer", "null"] },
        "resale_label": { "description": "전매제한(resale_months·등기 시 해제) 값의 Fact 라벨. null이면 라벨 미상(값이 있으면 '확인됨'으로 본다) — 2026-10-09.2", "anyOf": [{ "$ref": "label.json" }, { "type": "null" }] },
        "resale_release_on_registration": { "type": ["boolean", "null"] },
        "residency_months": { "type": ["integer", "null"] },
        "residency_label": { "description": "거주의무(residency_months) 값의 Fact 라벨 — 2026-10-09.2", "anyOf": [{ "$ref": "label.json" }, { "type": "null" }] },
        "down_payment_pct": { "type": ["number", "null"] },
        "move_in_label": { "description": "입주 예정월(move_in_ym) 값의 Fact 라벨(계약 2026-10-09.4, F2 요청 — 입주 성분 라벨 합성 R3 M2). null이면 라벨 미상(값이 있으면 '확인됨'으로 본다)", "anyOf": [{ "$ref": "label.json" }, { "type": "null" }] },
        "down_payment_label": { "description": "계약금 비율(down_payment_pct, 현재 payment_terms) 값의 Fact 라벨 — 2026-10-09.2", "anyOf": [{ "$ref": "label.json" }, { "type": "null" }] },
        "interim_terms_text": { "type": ["string", "null"] },
        "intake_status": { "type": ["string", "null"], "enum": ["가능", "미정", "확인 불가", "불가", null] },
        "intake_path": { "type": ["string", "null"], "enum": ["human_check", "official_popup", "headless_shot", "unofficial_ref", null] },
        "intake_checked_at": { "description": "표시 접수 상태(intake_status 행)의 확인 시각 ISO 8601(날짜만도 허용). 요건 사전 계산 근거에 '확인 D±'로 쓴다 — 2026-10-09.2", "type": ["string", "null"] },
        "regulated": { "type": ["boolean", "null"] },
        "rewin_restriction_years": { "type": ["integer", "null"] },
        "has_priority_supply": { "description": "가점제 1순위 공급(본청약·예정 공고) 경로가 있음", "type": ["boolean", "null"] },
        "fixed_components": { "anyOf": [{ "$ref": "#/$defs/FixedComponents" }, { "type": "null" }] }
      }
    }
  },
  "examples": [
    {
      "snapshot_id": 12, "asof_date": "2026-10-08",
      "region": { "age_premium_coef": { "c_per_year": 0.015, "cap_years": 8, "label": "추정" }, "supply_ref_pct": 0.08 },
      "rerank": { "judgment_seq": 124, "status": "ok", "items": [{ "candidate_id": "complex:2", "complex_id": 2, "relevance": 0.89, "rank": 1 }], "prev": null },
      "living_areas": [{ "id": "la_2", "name": "검단구", "households": null, "unsold_scope_codes": ["28290"] }],
      "trades": [],
      "benchmarks": [],
      "supply": [],
      "unsold": [{ "ym": "2026-08", "scope_code": "28290", "total": 737, "post_completion": 737, "label": "재가공" }],
      "complexes": [
        {
          "complex_id": 2, "name": "엘리프 검단 포레듀", "living_area": "la_2", "judge_scope": "판정 대상",
          "price_low_won": 578000000, "price_high_won": 608000000, "price_label": "확인됨", "move_in_ym": "2028-03",
          "immediate_move_in": false, "completed_year": null,
          "ladders": [{ "horizon": "move_in_plus_1y", "target_ym": "2029-03", "months_from_asof": 29, "p5": 0.48, "p10": 0.45, "p20": 0.36, "p_flat": 0.48, "status": "ok", "judgment_seq": 68 }],
          "winner_date": "2025-09-10", "resale_months": 36, "resale_label": "확인됨", "resale_release_on_registration": true,
          "residency_months": 0, "residency_label": "확인됨", "down_payment_pct": 5, "down_payment_label": "확인됨",
          "interim_terms_text": "중도금 60% 이자후불", "intake_status": "가능", "intake_path": "official_popup",
          "intake_checked_at": "2026-10-07T09:20:00+09:00",
          "regulated": false, "rewin_restriction_years": 10, "has_priority_supply": false,
          "fixed_components": { "source": "보고서 §12-4-3", "p10": 4.5, "rerank": 8.9, "gap": 6.3, "benchmark": 5.0, "supply": 3.0, "liquidity": 6.0 }
        }
      ]
    }
  ]
}

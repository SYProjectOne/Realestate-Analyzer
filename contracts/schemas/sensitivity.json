{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensitivity.json",
  "title": "Sensitivity",
  "description": "GET /snapshots/{sid}/sensitivity?scenario= — C10 민감도 (RA §6-6). 가중치 6개 각각 ±0.10을 주고(0~1로 자름) 나머지 5개를 원래 비율대로 재정규화해 합 1을 맞춘 12개 변형마다 종합 점수·순위를 다시 구한다: w_i' = clamp(w_i ± 0.10, 0, 1), w_j' = w_j × (1 − w_i')/(1 − w_i) (j≠i).\nTOP 5 집합 = rank ≤ 5 인 단지 전부(공동 5위 포함, 동점 규칙은 ScoreRunResult와 같음). 한 변형이라도 집합이 바뀌면 unstable=true, 들어오거나 나간 단지가 unstable_complex_ids(score_total.unstable=true). stable_components = 두 변형 모두 집합이 그대로인 성분(화면에서 회색).\ncells는 성분 순서(p10, rerank, gap, benchmark, supply, liquidity|move_in) × (+, −) 순 12개.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "scenario_id",
    "score_run_id",
    "base_weights",
    "base_top5",
    "cells",
    "unstable",
    "unstable_complex_ids",
    "stable_components"
  ],
  "properties": {
    "snapshot_id": {
      "type": "integer"
    },
    "scenario_id": {
      "type": "integer"
    },
    "score_run_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "base_weights": {
      "$ref": "scenario.json#/$defs/Weights"
    },
    "base_top5": { "x-nonfact": "식별자 목록(complex_id)",
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/SensitivityCell"
      }
    },
    "unstable": {
      "type": "boolean"
    },
    "unstable_complex_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "stable_components": {
      "type": "array",
      "items": {
        "$ref": "scenario.json#/$defs/ComponentKey"
      }
    },
    "complex_names": {
      "description": "base_top5·cells[].top5·entered·exited·ranks 에 나오는 단지 id(문자열 키) → 단지 이름(표시용, 2026-10-09.2)",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "SensitivityCell": {
      "title": "SensitivityCell",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "component",
        "delta",
        "weights",
        "top5",
        "ranks",
        "changed",
        "entered",
        "exited"
      ],
      "properties": {
        "variant": {
          "description": "'<component>+0.10' 또는 '<component>-0.10'",
          "type": "string"
        },
        "component": {
          "$ref": "scenario.json#/$defs/ComponentKey"
        },
        "delta": { "x-nonfact": "가중치 변형 크기(±0.10 가정, §6-6)",
          "type": "number",
          "enum": [
            0.1,
            -0.1
          ]
        },
        "weights": {
          "$ref": "scenario.json#/$defs/Weights"
        },
        "top5": { "x-nonfact": "식별자 목록(complex_id)",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "ranks": {
          "description": "기준 TOP 5 ∪ 변형 TOP 5 단지의 변형 순위·점수(C10 작은 선)",
          "type": "array",
          "items": {
            "title": "SensitivityRank",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "complex_id",
              "rank",
              "total"
            ],
            "properties": {
              "complex_id": {
                "type": "integer"
              },
              "name": {
                "description": "단지 이름(표시용, 2026-10-09.2). 없으면 화면이 complex_names 또는 id로 찾는다",
                "type": [
                  "string",
                  "null"
                ]
              },
              "rank": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "total": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "changed": {
          "type": "boolean"
        },
        "entered": { "x-nonfact": "식별자 목록(complex_id)",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "exited": { "x-nonfact": "식별자 목록(complex_id)",
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    }
  },

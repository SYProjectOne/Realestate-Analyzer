# subscription-analyzer 환경변수 예시 (RA §10, DECISIONS D1·D6). 값은 예시일 뿐이다.
#
#   로컬(Docker 없이):  cp infra/.env.example backend/.env   (backend/ 에서 uv run …)
#   Docker compose:    cp infra/.env.example infra/.env
#   다른 위치의 .env:   ENV_FILE=/path/to/.env uv run …   (예: worktree 에서 메인 체크아웃의 .env 를 읽을 때.
#                      ENV_FILE 은 셸 환경변수로만 준다 — .env 안에 쓰면 의미가 없다)
#
# .env 는 절대 커밋하지 않는다(.gitignore). 비밀값은 여기 빈칸으로 두고 실제 .env 에만 넣는다.

# ---------------------------------------------------------------- 실행 환경
# dev: 출처 누락 시 예외 / prod: 라벨 "확인 불가(출처 누락)" + 경고, API_TOKEN 필수
ENV=dev
TZ=Asia/Seoul
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------- 저장소
# 개발은 SQLite 파일(서비스 없이). compose 는 아래 POSTGRES_* 로 DATABASE_URL 을 만들어 덮어쓴다.
DATABASE_URL=sqlite:///./dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQLITE_BUSY_TIMEOUT_MS=5000
# 원문 /data/raw/{source}/{yyyy-mm-dd}/{sha256}.{ext} (ADR-8). compose 에서는 /data/raw 로 고정.
RAW_DIR=./data/raw
# 법정동·행정동·세대수 참조 파일 (DECISIONS D2-1)
REFERENCE_DIR=./data/reference
# 보고서 HTML·PDF 출력 (DECISIONS D4)
REPORT_DIR=./data/reports
# 보고서 HTML 에 인라인할 echarts.min.js 경로. 비우면 frontend/node_modules/echarts/dist 를 찾는다(worker 이미지는
# /opt/echarts/echarts.min.js 를 넣고 이 값을 설정한다). 없으면 차트 자리에 '차트 번들 없음' + 표만.
REPORT_ECHARTS_JS=

# compose 전용 (db 서비스)
POSTGRES_USER=sa
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=subscription
API_PORT=8000
WEB_PORT=8080

# ---------------------------------------------------------------- API·인증 (ADR-9)
API_PREFIX=/api
# 32자 랜덤: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=
# 공유 링크는 READONLY 만 (만료 일수)
READONLY_TOKEN=
SHARE_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------- 판정기 (ADR-5, D6)
# jev | mock (테스트는 mock)
JUDGE_ADAPTER=jev
# stdio MCP 실행 명령. JEV 자체 키는 JEV 의 환경변수로(여기 아님). 임계값은 JEV 기본값을 따른다.
JEV_MCP_CMD="npx -y @jkudish/jev-mcp@latest"
# 도구 호출 1건 / 기동(initialize, 첫 npx 다운로드 포함) 제한 시간(초). 넘기면 JudgeUnavailable(T18)
JUDGE_CALL_TIMEOUT_S=120
JUDGE_START_TIMEOUT_S=300

# ---------------------------------------------------------------- 외부 키 (없으면 해당 기능 비활성)
# 공공데이터포털 일반 인증키(하나로 아래를 모두 부른다; 서비스마다 data.go.kr 에서 '활용신청'이 따로 필요)
#  - 국토교통부 아파트 매매 실거래가 자료(apis.data.go.kr, rtms) (D1 #5: 없으면 rtms 비활성)
#  - 한국부동산원 청약홈 분양정보 조회 서비스(api.odcloud.kr ApplyhomeInfoDetailSvc, data.go.kr 15098547)
#  - 한국부동산원 청약홈 청약접수 경쟁률 및 특별공급 신청현황 조회 서비스
#    (api.odcloud.kr ApplyhomeInfoCmpetRtSvc, data.go.kr 15098905) — 미신청이면 401, 웹 경쟁률로 폴백
#  키가 없거나 API 가 실패하면 청약홈은 웹(www.applyhome.co.kr) 수집으로 폴백한다.
DATA_GO_KR_KEY=
# 뉴스 검색 API 제공자: ncp = NAVER Cloud API HUB "NAVER 검색"(naverapihub.apigw.ntruss.com,
#   헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY) — 기본값
#   naver_developers = 레거시 개발자센터(openapi.naver.com, X-Naver-Client-Id / X-Naver-Client-Secret)
NEWS_API_PROVIDER=ncp
# 키 두 개를 콜론으로: ncp 는 <X-NCP-APIGW-API-KEY-ID>:<X-NCP-APIGW-API-KEY>,
#   naver_developers 는 <ClientID>:<Secret> (D1 #6: 없으면 news collector 비활성)
NEWS_API_KEY=
# 알림 URL 1개, critical change_event 만 (D1 #7: 비면 보내지 않음)
WEBHOOK_URL=

# ---------------------------------------------------------------- 수집 HTTP (core.http)
# 호스트당 초당 요청 수 (1 = 1초 간격)
HTTP_RATE_PER_HOST=1
# 첫 시도 이후 재시도 횟수 (5xx·타임아웃·연결 오류만; 4xx 는 재시도 안 함)
HTTP_MAX_RETRIES=3
HTTP_TIMEOUT_S=30
HTTP_BACKOFF_BASE_S=1
HTTP_BACKOFF_MAX_S=60
HTTP_USER_AGENT="subscription-analyzer/0.1 (public housing-subscription info collector)"
# robots.txt 를 보지 않는 키 인증 공식 API 호스트(쉼표 구분). 크롤링이 아니라 이용약관이 규율한다.
HTTP_ROBOTS_EXEMPT_HOSTS=apis.data.go.kr,api.odcloud.kr,openapi.naver.com,naverapihub.apigw.ntruss.com

# ---------------------------------------------------------------- worker
WORKER_HEARTBEAT_S=60

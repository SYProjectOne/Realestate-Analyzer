# api — FastAPI (uvicorn). 빌드 컨텍스트 = 저장소 루트.
#   docker build -f infra/Dockerfile.api .
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /uvx /bin/

WORKDIR /app/backend

# 의존성 먼저(캐시 레이어)
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# 코드 + 계약(마이그레이션·스키마는 읽기 전용으로 동봉)
COPY backend/ ./
COPY contracts/ /app/contracts/
RUN uv sync --frozen --no-dev

RUN useradd --system --uid 10001 --home /app app && mkdir -p /data && chown -R app /data
USER app

EXPOSE 8000

# alembic.ini 가 있으면 마이그레이션 후 기동(마이그레이션은 api 만 수행 — worker 는 api healthy 뒤에 뜬다)
CMD ["sh", "-c", "if [ -f alembic.ini ]; then alembic upgrade head; fi; exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]

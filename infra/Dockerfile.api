# api — FastAPI (uvicorn). 빌드 컨텍스트 = 저장소 루트.
#   docker build -f infra/Dockerfile.api .
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /uvx /bin/

WORKDIR /app/backend

# 의존성 먼저(캐시 레이어)
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# 코드 + 계약(마이그레이션·스키마는 읽기 전용으로 동봉)
COPY backend/ ./
COPY contracts/ /app/contracts/
RUN uv sync --frozen --no-dev

RUN useradd --system --uid 10001 --home /app app && mkdir -p /data && chown -R app /data
USER app

EXPOSE 8000

# 컨테이너 안에서는 모든 인터페이스(compose 네트워크)에 바인드한다. 단 토큰(API_TOKEN·READONLY_TOKEN)이
# 모두 비면 app.serve 가 127.0.0.1 로 바꾸고 경고한다(R3 M11) — compose 는 API_TOKEN 없이 기동하지 않는다.
ENV API_HOST=0.0.0.0 \
    API_PORT=8000

# alembic.ini 가 있으면 마이그레이션 후 기동(마이그레이션은 api 만 수행 — worker 는 api healthy 뒤에 뜬다).
# app.serve = uvicorn app.main:app (proxy headers 포함)
CMD ["sh", "-c", "if [ -f alembic.ini ]; then alembic upgrade head; fi; exec python -m app.serve"]

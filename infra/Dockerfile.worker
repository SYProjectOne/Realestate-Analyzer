# worker — 스케줄러·수집·판정·점수·보고서. 빌드 컨텍스트 = 저장소 루트.
#   docker build -f infra/Dockerfile.worker .
# 포함: Playwright chromium(동적 팝업 렌더·PDF 인쇄), Node(npx 로 JEV MCP 실행 — DECISIONS D6), 한글 글꼴,
#       보고서 HTML 에 인라인할 ECharts 번들(echarts.min.js, 버전 = frontend/package-lock.json 의 echarts).
FROM node:20-bookworm-slim AS node

# ECharts 번들 — 보고서(WP8 render.py)가 HTML 에 인라인한다(외부 URL 리소스 0, DECISIONS D4)
FROM node:20-bookworm-slim AS echarts
ARG ECHARTS_VERSION=6.1.0
WORKDIR /echarts
RUN npm pack "echarts@${ECHARTS_VERSION}" --silent \
 && tar -xzf "echarts-${ECHARTS_VERSION}.tgz" package/dist/echarts.min.js \
 && test -s package/dist/echarts.min.js

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    REPORT_ECHARTS_JS=/opt/echarts/echarts.min.js \
    NPM_CONFIG_CACHE=/home/app/.npm \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata ca-certificates fonts-noto-cjk \
 && rm -rf /var/lib/apt/lists/*

# Node 런타임(npx) — 공식 node 이미지에서 복사
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version && npx --version

COPY --from=echarts /echarts/package/dist/echarts.min.js /opt/echarts/echarts.min.js

COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /uvx /bin/

WORKDIR /app/backend

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# chromium + 시스템 의존성
RUN playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*

COPY backend/ ./
COPY contracts/ /app/contracts/
# 운영 스크립트(runbook §6 원문 월별 압축) — exec worker /app/infra/raw_archive.sh (재리뷰 m34)
COPY infra/raw_archive.sh /app/infra/raw_archive.sh
RUN chmod 755 /app/infra/raw_archive.sh
RUN uv sync --frozen --no-dev

RUN useradd --system --uid 10001 --create-home --home-dir /home/app app \
 && mkdir -p /data && chown -R app /data /home/app
USER app

# JEV MCP 패키지를 미리 받아 둔다(실패해도 빌드는 계속 — 실행 시 npx 가 다시 받는다)
RUN timeout 120 npx -y @jkudish/jev-mcp@latest --version </dev/null >/dev/null 2>&1 || true

CMD ["python", "-m", "app.worker"]
